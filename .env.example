# Database Connection (PostgreSQL or leave empty for local SQLite fallback)
DATABASE_URL=

# Application Server
PORT=8000
CORS_ORIGINS=*

# JWT Security
JWT_SECRET=your-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Dispatch (Optional: if unset, emails are safely simulated)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@bloodmatch.io
SMTP_FROM_NAME=BloodMatch Transfusion Network
SMTP_USE_TLS=true
